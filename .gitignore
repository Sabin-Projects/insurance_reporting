# Python virtual environment - reinstall with: pip install -r requirements.txt
.venv/

# Python cache files (created automatically when code runs)
__pycache__/

# Mac system files
.DS_Store

# Data - raw files are downloaded from their sources (listed in README),
# processed and outputs are regenerated by running the code
raw/*.csv
processed/
# Outputs: keep the small result files the dashboard reads; skip the large ones
outputs/general_ledger.csv
outputs/profile_*.csv